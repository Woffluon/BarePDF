# ==========================================
# BarePDF Professional .gitignore
# ==========================================

# ------------------------------------------
# Rust & Cargo Output
# ------------------------------------------
/target/
**/*.rs.bk
*.bk
cargo-timing.html

# ------------------------------------------
# Code Signing & Secret Keys (SECURITY)
# ------------------------------------------
*.pfx
*.p12
*.pem
*.cer
*.key
*.crt
*.asc
.env
.env.*
!.env.example

# ------------------------------------------
# Windows System Files
# ------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.deb
*.rpm
*.stackdump

# ------------------------------------------
# macOS System Files
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------
# Linux System Files
# ------------------------------------------
*~
.fuse_hidden*
.directory
.trash

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (CLion, Fleet, RustRover)
.idea/
*.iml

# Visual Studio
.vs/
*.user
*.userosv
*.sln.docstates
*.suo

# Rust Analyzer & Tooling
.rust-analyzer
.cargo-ok

# ------------------------------------------
# Inno Setup & Build Temporary Files
# ------------------------------------------
*.tmp
*.log
Output/
