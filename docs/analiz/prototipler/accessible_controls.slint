// Bağımsız Tasarım Taslağı — Faz 5 (docs/analiz/05-oneriler.md)
// Not: slint-viewer / slint-lsp kurulu olmadığı için derleme/çalıştırma doğrulaması yapılmamıştır.
// Kapsam: WCAG 2.2 AA uyumlu token eklemeleri, birleşik ActionButton, 24x24px+ hedef kapsayıcıları,
//        klavye odaklı FilterPill ve AccessKit uyumlu ZoomSlider önerisi.

import { Palette } from "std-widgets.slint";

export global PrototypeTokens {
    in-out property <bool> system-reduce-effects: false;
    in-out property <bool> smartboard-mode: false;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <duration> motion-fast: system-reduce-effects ? 0ms : 80ms;
    out property <duration> motion-medium: system-reduce-effects ? 0ms : 120ms;

    // Yüzeyler (crates/barepdf-ui/ui/tokens.slint ile uyumlu)
    out property <color> window: dark ? #202020 : #f3f3f3;
    out property <color> layer: dark ? #2b2b2b : #fbfbfb;
    out property <color> control: dark ? #2d2d2d : #ffffff;
    out property <color> control-hover: dark ? #383838 : #eaeaea;
    out property <color> control-pressed: dark ? #242424 : #dfdfdf;
    out property <color> toast-bg: dark ? #2c2c2c : #ffffff;

    // İyileştirilmiş WCAG 2.2 AA sınır, gösterge ve durum token'ları
    out property <color> divider: dark ? #333333 : #e2e2e2;              // Yalnızca dekoratif ayırıcı
    out property <color> stroke-control: dark ? #787878 : #858585;       // 3.12:1 (Dark) / 3.69:1 (Light) >= 3.0:1
    out property <color> track-bg: dark ? #787878 : #8a8a8a;             // 3.16:1 (Dark) / 3.45:1 (Light) >= 3.0:1

    out property <color> text: dark ? #f5f5f5 : #1b1b1b;
    out property <color> text-muted: dark ? #d0d0d0 : #333333;
    out property <color> text-subtle: dark ? #d0d0d0 : #5e6570;          // 8.93:1 (Dark) / 5.88:1 (Light) >= 4.5:1

    out property <color> accent: #f69423;
    out property <color> accent-hover: #faad52;
    out property <color> accent-pressed: #df7d13;
    out property <color> accent-content: #181105;                        // 8.19:1 (Light & Dark birleşik buton metni)
    out property <color> accent-indicator: dark ? #f69423 : #b85600;     // 6.19:1 (Dark) / 4.64:1 (Light) >= 3.0:1

    out property <color> danger: dark ? #ff99a4 : #c42b1c;               // Metin/ikon (layer üzerinde >= 5.47:1)
    out property <color> danger-fill: dark ? #a81c24 : #c42b1c;          // Dolgu butonu (#ffffff ile 7.35:1 / 5.66:1)
    out property <color> danger-fill-hover: dark ? #be242c : #d13426;
    out property <color> success: dark ? #4ec97d : #107c41;              // Toast üzerinde 6.63:1 / 5.27:1
    out property <color> info: dark ? #60cdff : #0078d4;
    out property <color> focus: dark ? #f6a14a : #9a4100;
    out property <color> scrim-modal: #00000080;

    out property <length> control-radius: 4px;
    out property <length> overlay-radius: 8px;
}

// TextButton + TouchButton tek bileşende birleştirildi:
// Akıllı tahta veya masaüstü fark etmeksizin primary metin daima accent-content (#181105),
// danger dolgu butonu dark modda #a81c24 üzerinde #ffffff kullanır.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> touch-mode: PrototypeTokens.smartboard-mode;
    in property <bool> enabled: true;
    callback clicked;

    min-height: touch-mode ? 48px : 32px;
    min-width: touch-mode ? 96px : 72px;
    border-radius: touch-mode ? 8px : PrototypeTokens.control-radius;
    background: !enabled ? PrototypeTokens.control
        : danger ? (ta.pressed ? PrototypeTokens.danger-fill : ta.has-hover ? PrototypeTokens.danger-fill-hover : PrototypeTokens.danger-fill)
        : primary ? (ta.pressed ? PrototypeTokens.accent-pressed : ta.has-hover ? PrototypeTokens.accent-hover : PrototypeTokens.accent)
        : (ta.pressed ? PrototypeTokens.control-pressed : ta.has-hover ? PrototypeTokens.control-hover : PrototypeTokens.control);
    border-width: (primary || danger) ? 0px : 1px;
    border-color: fs.has-focus ? PrototypeTokens.focus : PrototypeTokens.stroke-control;
    opacity: enabled ? 1.0 : 0.6;

    animate background { duration: PrototypeTokens.motion-fast; }

    // 2px WCAG SC 2.4.13 uyumlu odak halkası
    if fs.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px;
        border-color: PrototypeTokens.focus;
    }

    Text {
        text: root.label;
        color: danger ? #ffffff
            : primary ? PrototypeTokens.accent-content
            : PrototypeTokens.text;
        font-size: touch-mode ? 15px : 13px;
        font-weight: (primary || danger) ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.accessible-name;
        accessible-enabled: root.enabled;

        key-pressed(event) => {
            if (root.enabled && (event.text == " " || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: enabled ? pointer : default;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }
}

// 22x22 sekme kapatma düğmesini 26x26px erişilebilir tıklama alanına genişletir (WCAG SC 2.5.8).
export component TabCloseHitTarget inherits Rectangle {
    in property <string> close-label: "Close tab";
    callback clicked;

    width: PrototypeTokens.smartboard-mode ? 44px : 26px;
    height: PrototypeTokens.smartboard-mode ? 44px : 26px;
    border-radius: 4px;
    background: ta.pressed ? PrototypeTokens.control-pressed
        : ta.has-hover ? PrototypeTokens.control-hover
        : #00000000;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: PrototypeTokens.focus;

    Text {
        text: "×";
        font-size: 14px;
        color: PrototypeTokens.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        accessible-role: button;
        accessible-label: root.close-label;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// Tuval imza / metin notu tutamaçları için görsel 14x14px ikonu 24x24px hedef içinde merkeze alır.
export component CanvasCornerHandle inherits Rectangle {
    in property <string> accessible-name: "Resize";
    callback moved(dx: length, dy: length);

    width: PrototypeTokens.smartboard-mode ? 44px : 24px;
    height: PrototypeTokens.smartboard-mode ? 44px : 24px;
    background: #00000000;

    Rectangle {
        x: (parent.width - 14px) / 2;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        background: PrototypeTokens.accent;
        border-width: 1px;
        border-color: PrototypeTokens.accent-content;
    }

    TouchArea {
        accessible-role: button;
        accessible-label: root.accessible-name;
        mouse-cursor: nwse-resize;
        moved => {
            if (self.pressed) {
                root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

// Ölü FilterPill bileşeninin FocusScope + AccessKit özellikli yenilenmiş sürümü.
export component AccessibleFilterPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    min-height: 28px;
    border-radius: 14px;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? PrototypeTokens.focus
        : active ? PrototypeTokens.accent-indicator
        : PrototypeTokens.stroke-control;
    background: active ? (PrototypeTokens.dark ? #544029 : #faecdb)
        : (ta.has-hover ? PrototypeTokens.control-hover : PrototypeTokens.control);
    animate background { duration: PrototypeTokens.motion-fast; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: active ? 600 : 400;
            color: PrototypeTokens.text;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        accessible-role: button;
        accessible-label: root.label;
        accessible-checked: root.active;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }
}

// Klavye ok tuşları ve AccessKit slider semantiği destekleyen ZoomSlider taslağı.
export component AccessibleZoomSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <float> minimum: 0.25;
    in property <float> maximum: 4.0;
    in property <float> step: 0.1;
    in property <string> accessible-name: "Scale";
    callback changed(new-value: float);

    property <float> clamped-ratio: clamp((value - minimum) / max(0.001, maximum - minimum), 0.0, 1.0);

    height: 28px;
    background: #00000000;

    // Track (WCAG SC 1.4.11 >= 3:1)
    Rectangle {
        x: 6px;
        y: (parent.height - 4px) / 2;
        width: max(0px, parent.width - 12px);
        height: 4px;
        border-radius: 2px;
        background: PrototypeTokens.track-bg;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.clamped-ratio;
            height: 4px;
            border-radius: 2px;
            background: PrototypeTokens.accent-indicator;
        }
    }

    // Thumb
    Rectangle {
        x: 6px + (max(0px, parent.width - 28px)) * root.clamped-ratio;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: PrototypeTokens.accent;
        border-width: fs.has-focus ? 2px : 1px;
        border-color: fs.has-focus ? PrototypeTokens.focus : PrototypeTokens.accent-content;
    }

    fs := FocusScope {
        accessible-role: slider;
        accessible-label: root.accessible-name;
        accessible-value: Math.round(root.value * 100) + "%";
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-value-step: root.step;

        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = max(root.minimum, root.value - root.step);
                root.changed(root.value);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = min(root.maximum, root.value + root.step);
                root.changed(root.value);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            function update-from-x(mx: length) {
                let usable = max(1px, root.width - 12px);
                let ratio = clamp((mx - 6px) / usable, 0.0, 1.0);
                root.value = root.minimum + ratio * (root.maximum - root.minimum);
                root.changed(root.value);
            }
            clicked => {
                fs.focus();
                self.update-from-x(self.mouse-x);
            }
            moved => {
                if (self.pressed) {
                    self.update-from-x(self.mouse-x);
                }
            }
        }
    }
}
