import { Palette } from "std-widgets.slint";

export global ThemeTokens {
    in-out property <int> theme-mode: 0;
    in-out property <bool> system-reduce-effects: false;
    in-out property <int> paper-tint: 0; // 0: Normal, 1: Sepia, 2: Night, 3: Amber
    out property <bool> motion-active: !system-reduce-effects;
    out property <duration> motion-fast: motion-active ? 80ms : 0ms;
    out property <duration> motion-medium: motion-active ? 120ms : 0ms;

    changed theme-mode => {
        Palette.color-scheme = theme-mode == 1 ? ColorScheme.light
            : (theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown);
    }
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Windows 11 Neutral (Mica-toned, opaque) + BarePDF Warm Amber Identity
    out property <color> window: dark ? #202020 : #f3f3f3;
    out property <color> layer: dark ? #2b2b2b : #fbfbfb;
    out property <color> layer-elevated: dark ? #323232 : #ffffff;
    out property <color> canvas: paper-tint == 1 ? #f4ecd8
        : (paper-tint == 2 ? #111111
        : (paper-tint == 3 ? #1a1600
        : (dark ? #181818 : #e6e6e6)));
    out property <color> control: dark ? #2d2d2d : #ffffff;
    out property <color> control-subtle: dark ? #ffffff0d : #00000008;
    out property <color> control-hover: dark ? #383838 : #eaeaea;
    out property <color> control-pressed: dark ? #242424 : #dfdfdf;
    out property <color> stroke: dark ? #3a3a3a : #dcdcdc;
    out property <color> divider: dark ? #333333 : #e2e2e2;
    out property <color> text: dark ? #f5f5f5 : #1b1b1b;
    out property <color> text-muted: dark ? #a6a6a6 : #5c5c5c;
    out property <color> accent: #f69423;
    out property <color> accent-hover: #faad52;
    out property <color> accent-content: #181105;
    out property <color> selection: dark ? #f6942333 : #f6942326;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> caption-close-hover: #c42b1c;
    out property <color> focus: dark ? #f6a14a : #9a4100;

    // Paper Tinting Colors
    out property <color> paper-tint-bg: paper-tint == 1 ? #f4ecd8
        : (paper-tint == 2 ? #111111 : (paper-tint == 3 ? #1a1600 : canvas));
    out property <color> paper-tint-fg: paper-tint == 1 ? #2c2218
        : (paper-tint == 2 ? #dcdcdc : (paper-tint == 3 ? #f69423 : text));

    // Spacing & Geometry
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> bar-height: 40px;
    out property <length> control-height: 32px;
    out property <length> control-radius: 4px;
    out property <length> overlay-radius: 8px;
    out property <length> page-radius: 2px;
    out property <length> focus-width: 2px;
    out property <length> overlay-shadow-blur: 16px;
    out property <length> overlay-shadow-offset-y: 4px;
    out property <color> overlay-shadow: dark ? #00000066 : #00000024;
}
