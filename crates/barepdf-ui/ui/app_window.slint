                            text: ft.text;
                            font-size: ft.font_size;
                            color: ft.color;
                        }
                        page-touch-1 := TouchArea {
                            property <length> pan-last-abs-y: 0px;
                            property <length> pan-last-abs-x: 0px;
                            mouse-cursor: (root.drawing-mode-active && !root.pan-mode-active) ? (root.drawing-typewriter-active ? text : crosshair) : (root.pan-mode-active ? (self.pressed ? grabbing : grab) : text);
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.page-right-clicked(
                                        spread-scroll.first-idx,
                                        self.mouse-x / Math.max(1px, self.width),
                                        self.mouse-y / Math.max(1px, self.height),
                                        self.absolute-position.x + self.mouse-x,
