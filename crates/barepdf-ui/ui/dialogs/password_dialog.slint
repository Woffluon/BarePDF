import { ThemeTokens } from "../tokens.slint";
import { TextButton } from "../components/button.slint";
import { DialogFooter } from "../components/dialog.slint";
import { LineEdit } from "std-widgets.slint";

export component PasswordDialog inherits Rectangle {
    in-out property <string> password-input: "";
    in property <string> file-name: "";
    in property <string> error-text: "";
    in property <string> title: "";
    in property <string> placeholder: "";
    in property <string> cancel-label: "";
    in property <string> unlock-label: "";
    callback submit(string);
    callback cancel();

    public function clear-password() {
        password-field.text = "";
        root.password-input = "";
    }

    public function focus-input() {
        password-field.focus();
    }

    function submit-and-clear() {
        let submitted = root.password-input;
        root.clear-password();
        root.submit(submitted);
    }

    function cancel-and-clear() {
        root.clear-password();
        root.cancel();
    }

    init => {
        root.clear-password();
    }

    width: 100%;
    height: 100%;
    background: ThemeTokens.dark ? #00000088 : #00000055;
    forward-focus: modal-focus;

    TouchArea {
        clicked => { root.cancel-and-clear(); }
    }

    modal-focus := FocusScope {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: root.error-text == "" ? 236px : 284px;
        forward-focus: password-field;
        key-pressed(event) => {
            if (event.text == "\u{001b}") { root.cancel-and-clear(); return accept; }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: ThemeTokens.layer;
            border-radius: ThemeTokens.overlay-radius;
            border-width: 1px;
            border-color: ThemeTokens.stroke;
            drop-shadow-blur: ThemeTokens.overlay-shadow-blur;
            drop-shadow-offset-y: ThemeTokens.overlay-shadow-offset-y;
            drop-shadow-color: ThemeTokens.overlay-shadow;
            accessible-role: groupbox;
            accessible-label: root.title;

            TouchArea {}

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: root.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: ThemeTokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        close-btn := Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: ThemeTokens.control-radius;
                            background: close-touch.pressed ? ThemeTokens.control-pressed
                                : (close-touch.has-hover ? ThemeTokens.control-hover : #00000000);
                            animate background { duration: ThemeTokens.motion-fast; }
                            accessible-role: button;
                            accessible-label: root.cancel-label;

                            close-touch := TouchArea {
                                clicked => { root.cancel-and-clear(); }
                            }

                            Image {
                                source: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
                                width: 16px;
                                height: 16px;
                                colorize: ThemeTokens.text;
                                image-fit: contain;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: ThemeTokens.divider;
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../../../../assets/icons/document_pdf_20_regular.svg");
                            width: 16px;
                            height: 16px;
                            colorize: ThemeTokens.text-muted;
                            image-fit: contain;
                        }
                        Text {
                            text: root.file-name;
                            color: ThemeTokens.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    if root.error-text != "" : Rectangle {
                        height: 36px;
                        border-radius: ThemeTokens.control-radius;
                        background: ThemeTokens.danger.with-alpha(0.10);
                        border-width: 1px;
                        border-color: ThemeTokens.danger.with-alpha(0.55);
                        accessible-role: text;
                        accessible-label: root.error-text;
                        accessible-live-region: assertive;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: root.error-text;
                            color: ThemeTokens.danger;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    password-field := LineEdit {
                        text <=> root.password-input;
                        placeholder-text: root.placeholder;
                        accessible-label: root.placeholder;
                        input-type: password;
                        accepted => { root.submit-and-clear(); }
                    }

                    DialogFooter {
                        TextButton {
                            text: root.cancel-label;
                            clicked => { root.cancel-and-clear(); }
                        }
                        TextButton {
                            text: root.unlock-label;
                            primary: true;
                            clicked => { root.submit-and-clear(); }
                        }
                    }
                }
            }
        }
    }
}
