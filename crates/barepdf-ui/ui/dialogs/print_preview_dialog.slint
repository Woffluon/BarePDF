import { ThemeTokens } from "../tokens.slint";
import { TextButton } from "../components/button.slint";
import { DialogFooter } from "../components/dialog.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export component PrintPreviewDialog inherits Rectangle {
    in-out property <int> page: 0;
    in-out property <string> range: "";
    in-out property <int> orientation: 0;
    in property <image> image;
    in property <bool> has-image: false;
    in property <string> total-pages: "0";
    in property <[string]> printers: ["Microsoft Print to PDF", "OneNote (Desktop)", "Varsayılan Yazıcı"];
    in-out property <int> selected-printer: 0;
    in-out property <int> copies: 1;
    in-out property <int> range-mode: 0; // 0: All / Tümü, 1: Current / Geçerli, 2: Custom / Özel
    in-out property <int> paper-size: 0; // 0: A4, 1: Letter, 2: Legal
    in-out property <int> duplex: 0; // 0: Tek Taraflı, 1: Uzun Kenar, 2: Kısa Kenar
    in property <string> text-title: "Yazdır";
    in property <string> text-cancel-tooltip: "Kapat";
    in property <string> text-empty: "Sayfa önizlemesi";
    in property <string> text-page: "Sayfa";
    in property <string> text-previous: "Önceki";
    in property <string> text-next: "Sonraki";
    in property <string> text-page-range: "Sayfa Aralığı";
    in property <string> text-range-placeholder: "Örn: 1-3, 5, 8-10";
    in property <string> text-range-accessible: "Yazdırılacak sayfalar";
    in property <string> text-orientation: "Yönlendirme";
    in property <string> text-orientation-auto: "Otomatik";
    in property <string> text-orientation-portrait: "Dikey";
    in property <string> text-orientation-landscape: "Yatay";
    in property <string> text-printer: "Yazıcı Seçimi";
    in property <string> text-copies: "Kopya Sayısı";
    in property <string> text-all-pages: "Tümü";
    in property <string> text-current-page: "Geçerli";
    in property <string> text-custom-range: "Özel";
    in property <string> text-paper-size: "Kağıt Boyutu";
    in property <string> text-duplex: "Çift Taraflı Yazdırma";
    in property <string> text-duplex-off: "Tek Taraflı";
    in property <string> text-duplex-long: "Uzun Kenar";
    in property <string> text-duplex-short: "Kısa Kenar";
    in property <string> text-cancel: "İptal";
    in property <string> text-continue: "Yazdır";
    callback previous();
    callback next();
    callback range-changed(string);
    callback orientation-changed(int);
    callback duplex-changed(int);
    callback confirm();
    callback cancel();

    width: 100%;
    height: 100%;
    background: ThemeTokens.dark ? #00000088 : #00000055;
    forward-focus: dialog-focus;

    TouchArea {
        clicked => { root.cancel(); }
    }

    dialog-focus := FocusScope {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(parent.width - 32px, 760px);
        height: Math.min(parent.height - 32px, 580px);
        key-pressed(event) => {
            if (event.text == "\u{001b}") { root.cancel(); return accept; }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: ThemeTokens.layer;
            border-radius: ThemeTokens.overlay-radius;
            border-width: 1px;
            border-color: ThemeTokens.stroke;
            drop-shadow-blur: ThemeTokens.overlay-shadow-blur;
            drop-shadow-offset-y: ThemeTokens.overlay-shadow-offset-y;
            drop-shadow-color: ThemeTokens.overlay-shadow;
            accessible-role: groupbox;
            accessible-label: root.text-title;

            TouchArea {}

            VerticalLayout {
                spacing: 0px;

                // Standardized 44px Header
                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: root.text-title != "" ? root.text-title : "Yazdır";
                            color: ThemeTokens.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        close-btn := Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: ThemeTokens.control-radius;
                            background: close-touch.pressed ? ThemeTokens.control-pressed
                                : (close-touch.has-hover ? ThemeTokens.control-hover : #00000000);
                            animate background { duration: ThemeTokens.motion-fast; }
                            accessible-role: button;
                            accessible-label: root.text-cancel-tooltip != "" ? root.text-cancel-tooltip : "Kapat";

                            close-touch := TouchArea {
                                clicked => { root.cancel(); }
                            }

                            Image {
                                source: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
                                width: 16px;
                                height: 16px;
                                colorize: ThemeTokens.text;
                                image-fit: contain;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: ThemeTokens.divider;
                    }
                }

                // Body & Footer
                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 16px;
                    spacing: 12px;

                    // Main two-column content
                    HorizontalLayout {
                        spacing: 16px;
                        vertical-stretch: 1;

                        // Left Column: Live Page Preview
                        Rectangle {
                            width: Math.min(340px, parent.width * 0.48);
                            background: ThemeTokens.canvas;
                            border-radius: ThemeTokens.control-radius;
                            border-width: 1px;
                            border-color: ThemeTokens.stroke;

                            // Paper preview canvas
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 16px;
                                width: Math.min(parent.width - 32px, 260px);
                                height: parent.height - 76px;
                                border-radius: ThemeTokens.page-radius;
                                background: white;
                                border-width: 1px;
                                border-color: #00000020;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 2px;
                                drop-shadow-color: ThemeTokens.overlay-shadow;

                                if root.has-image : Image {
                                    source: root.image;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                                if !root.has-image : Text {
                                    text: root.text-empty != "" ? root.text-empty : "Sayfa önizlemesi";
                                    color: #626972;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Preview navigation bar
                            HorizontalLayout {
                                x: 0px;
                                y: parent.height - 48px;
                                width: parent.width;
                                height: 32px;
                                alignment: center;
                                spacing: 8px;
                                TextButton {
                                    text: root.text-previous != "" ? root.text-previous : "Önceki";
                                    enabled: root.page > 0;
                                    clicked => { root.previous(); }
                                }
                                Text {
                                    text: (root.text-page != "" ? root.text-page : "Sayfa") + " " + (root.page + 1) + " / " + root.total-pages;
                                    color: ThemeTokens.text;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                TextButton {
                                    text: root.text-next != "" ? root.text-next : "Sonraki";
                                    enabled: root.page + 1 < root.total-pages.to-float();
                                    clicked => { root.next(); }
                                }
                            }
                        }

                        // Right Column: Print Configuration Options
                        ScrollView {
                            horizontal-stretch: 1;

                            VerticalLayout {
                                spacing: 11px;
                                padding-right: 8px;
                                padding-top: 2px;
                                padding-bottom: 2px;

                                // 1. Yazıcı Seçimi (Printers Model)
                                Text {
                                    text: root.text-printer;
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    for printer-name[idx] in root.printers : Rectangle {
                                        height: 32px;
                                        border-radius: ThemeTokens.control-radius;
                                        background: root.selected-printer == idx ? ThemeTokens.selection : (p-touch.has-hover ? ThemeTokens.control-hover : ThemeTokens.control);
                                        border-width: 1px;
                                        border-color: root.selected-printer == idx ? ThemeTokens.accent : ThemeTokens.stroke;
                                        animate background { duration: ThemeTokens.motion-fast; }
                                        p-touch := TouchArea { clicked => { root.selected-printer = idx; } }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 12px;
                                                    height: 12px;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.selected-printer == idx ? ThemeTokens.accent : ThemeTokens.stroke;
                                                    if root.selected-printer == idx : Rectangle {
                                                        x: 3px;
                                                        y: 3px;
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: ThemeTokens.accent;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: printer-name;
                                                color: root.selected-printer == idx ? ThemeTokens.text : ThemeTokens.text-muted;
                                                font-size: 12px;
                                                font-weight: root.selected-printer == idx ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                // 2. Kopya Sayısı (Copies)
                                Text {
                                    text: root.text-copies;
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    TextButton {
                                        text: "-";
                                        enabled: root.copies > 1;
                                        clicked => { root.copies = Math.max(1, root.copies - 1); }
                                    }
                                    Rectangle {
                                        width: 52px;
                                        height: ThemeTokens.control-height;
                                        border-radius: ThemeTokens.control-radius;
                                        background: ThemeTokens.control;
                                        border-width: 1px;
                                        border-color: ThemeTokens.stroke;
                                        Text {
                                            text: "" + root.copies;
                                            color: ThemeTokens.text;
                                            font-size: 12px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TextButton {
                                        text: "+";
                                        enabled: root.copies < 99;
                                        clicked => { root.copies = Math.min(99, root.copies + 1); }
                                    }
                                }

                                // 3. Sayfa Aralığı (Tümü / Geçerli / Özel)
                                Text {
                                    text: root.text-page-range != "" ? root.text-page-range : "Sayfa Aralığı";
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    TextButton {
                                        text: root.text-all-pages;
                                        active: root.range-mode == 0;
                                        clicked => {
                                            root.range-mode = 0;
                                            root.range = "1-" + root.total-pages;
                                            root.range-changed(root.range);
                                        }
                                    }
                                    TextButton {
                                        text: root.text-current-page;
                                        active: root.range-mode == 1;
                                        clicked => {
                                            root.range-mode = 1;
                                            root.range = "" + (root.page + 1);
                                            root.range-changed(root.range);
                                        }
                                    }
                                    TextButton {
                                        text: root.text-custom-range;
                                        active: root.range-mode == 2;
                                        clicked => { root.range-mode = 2; }
                                    }
                                }
                                if root.range-mode == 2 : LineEdit {
                                    text <=> root.range;
                                    placeholder-text: root.text-range-placeholder != "" ? root.text-range-placeholder : "1-3, 5, 8-10";
                                    accessible-label: root.text-range-accessible;
                                    accepted => { root.range-changed(root.range); }
                                    changed text => { root.range-changed(self.text); }
                                }

                                // 4. Yönlendirme (Otomatik / Dikey / Yatay)
                                Text {
                                    text: root.text-orientation != "" ? root.text-orientation : "Yönlendirme";
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    TextButton {
                                        text: root.text-orientation-auto != "" ? root.text-orientation-auto : "Otomatik";
                                        active: root.orientation == 0;
                                        clicked => { root.orientation = 0; root.orientation-changed(0); }
                                    }
                                    TextButton {
                                        text: root.text-orientation-portrait != "" ? root.text-orientation-portrait : "Dikey";
                                        active: root.orientation == 1;
                                        clicked => { root.orientation = 1; root.orientation-changed(1); }
                                    }
                                    TextButton {
                                        text: root.text-orientation-landscape != "" ? root.text-orientation-landscape : "Yatay";
                                        active: root.orientation == 2;
                                        clicked => { root.orientation = 2; root.orientation-changed(2); }
                                    }
                                }

                                // 5. Kağıt Boyutu
                                Text {
                                    text: root.text-paper-size;
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    TextButton {
                                        text: "A4";
                                        active: root.paper-size == 0;
                                        clicked => { root.paper-size = 0; }
                                    }
                                    TextButton {
                                        text: "Letter";
                                        active: root.paper-size == 1;
                                        clicked => { root.paper-size = 1; }
                                    }
                                    TextButton {
                                        text: "Legal";
                                        active: root.paper-size == 2;
                                        clicked => { root.paper-size = 2; }
                                    }
                                }

                                // 6. Çift Taraflı Yazdırma (Duplex)
                                Text {
                                    text: root.text-duplex;
                                    color: ThemeTokens.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    TextButton {
                                        text: root.text-duplex-off;
                                        active: root.duplex == 0;
                                        clicked => { root.duplex = 0; root.duplex-changed(0); }
                                    }
                                    TextButton {
                                        text: root.text-duplex-long;
                                        active: root.duplex == 1;
                                        clicked => { root.duplex = 1; root.duplex-changed(1); }
                                    }
                                    TextButton {
                                        text: root.text-duplex-short;
                                        active: root.duplex == 2;
                                        clicked => { root.duplex = 2; root.duplex-changed(2); }
                                    }
                                }
                            }
                        }
                    }

                    // Footer Divider & Action Buttons
                    Rectangle { height: 1px; background: ThemeTokens.divider; }

                    DialogFooter {
                        TextButton {
                            text: root.text-cancel != "" ? root.text-cancel : "İptal";
                            clicked => { root.cancel(); }
                        }
                        TextButton {
                            text: root.text-continue != "" ? root.text-continue : "Yazdır";
                            primary: true;
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}
