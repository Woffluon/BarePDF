import { ThemeTokens } from "../tokens.slint";

export component ZoomSlider inherits Rectangle {
    in property <float> value: 1.0;
    in property <float> minimum: 0.25;
    in property <float> maximum: 5.0;
    callback value-changed(float);

    height: 24px;
    min-width: 120px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: ThemeTokens.control;
        border-width: 1px;
        border-color: ThemeTokens.border;

        fill := Rectangle {
            x: 0px;
            width: Math.max(0px, (root.value - root.minimum) / (root.maximum - root.minimum) * parent.width);
            height: parent.height;
            border-radius: 2px;
            background: ThemeTokens.accent;
        }
    }

    thumb := Rectangle {
        x: Math.max(0px, Math.min(parent.width - self.width, (root.value - root.minimum) / (root.maximum - root.minimum) * parent.width - self.width / 2));
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: touch.has-hover ? ThemeTokens.accent-hover : ThemeTokens.accent;
        border-width: 1px;
        border-color: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000033;
    }

    touch := TouchArea {
        moved => {
            let clamped = Math.max(0.0, Math.min(1.0, self.mouse-x / self.width));
            root.value-changed(root.minimum + clamped * (root.maximum - root.minimum));
        }
        clicked => {
            let clamped = Math.max(0.0, Math.min(1.0, self.mouse-x / self.width));
            root.value-changed(root.minimum + clamped * (root.maximum - root.minimum));
        }
    }
}
