import { ThemeTokens } from "../tokens.slint";

export struct TabItem {
    id: int,
    title: string,
    is_active: bool,
    is_loading: bool,
}

export component DocumentTab inherits Rectangle {
    in property <TabItem> item;
    in property <string> close-label;
    callback activate();
    callback close();

    width: 164px;
    height: 34px;
    border-radius: 6px;
    background: root.item.is_active ? ThemeTokens.layer
        : (tab-touch.pressed ? ThemeTokens.control-pressed : (tab-touch.has-hover ? ThemeTokens.control-hover : #00000000));
    border-width: root.item.is_active ? 1px : 0px;
    border-color: root.item.is_active ? ThemeTokens.stroke : #00000000;
    accessible-role: tab;
    accessible-label: root.item.title;
    animate background { duration: ThemeTokens.motion-fast; }

    tab-touch := TouchArea {
        clicked => { tab-focus.focus(); root.activate(); }
    }

    if root.item.is_active : Rectangle {
        x: 10px;
        y: parent.height - 2px;
        width: parent.width - 20px;
        height: 2px;
        border-radius: 1px;
        background: ThemeTokens.accent;
    }

    tab-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.activate(); return accept; }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;

        if root.item.is_loading : Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: ThemeTokens.accent;
        }
        Text {
            text: root.item.title;
            color: root.item.is_active ? ThemeTokens.text : ThemeTokens.text-muted;
            font-size: 12px;
            font-weight: root.item.is_active ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        close-button := Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: ThemeTokens.control-radius;
            background: close-touch.pressed ? ThemeTokens.control-pressed
                : (close-touch.has-hover ? ThemeTokens.control-hover : #00000000);
            accessible-role: button;
            accessible-label: root.close-label + " " + root.item.title;
            animate background { duration: ThemeTokens.motion-fast; }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }

            Image {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                source: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
                colorize: close-touch.has-hover ? ThemeTokens.text : ThemeTokens.text-muted;
                image-fit: contain;
                accessible-role: none;
            }
        }
    }

    if tab-focus.has-focus : Rectangle {
        border-width: ThemeTokens.focus-width;
        border-color: ThemeTokens.focus;
        border-radius: root.border-radius;
    }
}
