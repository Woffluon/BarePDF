import { ThemeTokens } from "../tokens.slint";

export component Scrubber inherits Rectangle {
    in property <bool> is-active: false;
    in property <string> preview-label: "";
    in property <length> y-position: 0px;

    visible: root.is-active;
    width: 100%;
    height: 100%;

    Rectangle {
        x: parent.width - self.width - 24px;
        y: root.y-position - self.height / 2;
        width: 90px;
        height: 32px;
        border-radius: ThemeTokens.control-radius;
        background: ThemeTokens.surface-modal;
        border-width: 1px;
        border-color: ThemeTokens.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;

        HorizontalLayout {
            alignment: center;
            spacing: ThemeTokens.space-1;

            Text {
                text: root.preview-label;
                color: ThemeTokens.accent;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}
