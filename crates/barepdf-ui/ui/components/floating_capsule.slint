import { ThemeTokens } from "../tokens.slint";
import { IconButton } from "./icon_button.slint";

export component FloatingCapsule inherits Rectangle {
    in property <string> page-info: "";
    in property <bool> can-prev: true;
    in property <bool> can-next: true;
    in property <bool> show-zoom: true;
    in property <string> exit-label: "Exit (Esc)";
    in property <string> prev-label: "Previous page";
    in property <string> next-label: "Next page";
    in property <string> zoom-in-label: "Zoom In";
    in property <string> zoom-out-label: "Zoom Out";
    callback prev();
    callback next();
    callback zoom-in();
    callback zoom-out();
    callback exit();

    width: 100%;
    height: 100%;
    background: #00000000;

    // Top-right fail-safe exit pill reveal zone
    top-zone := TouchArea {
        x: parent.width - 180px;
        y: 0px;
        width: 180px;
        height: 64px;

        exit-pill := Rectangle {
            x: parent.width - self.width - 16px;
            y: 16px;
            width: exit-pill-layout.preferred-width;
            height: 32px;
            border-radius: ThemeTokens.overlay-radius;
            background: exit-pill-touch.pressed ? ThemeTokens.control-pressed
                : (exit-pill-touch.has-hover ? ThemeTokens.control-hover : ThemeTokens.layer-elevated);
            border-width: 1px;
            border-color: ThemeTokens.stroke;
            drop-shadow-blur: ThemeTokens.overlay-shadow-blur;
            drop-shadow-offset-y: ThemeTokens.overlay-shadow-offset-y;
            drop-shadow-color: ThemeTokens.overlay-shadow;
            opacity: (top-zone.has-hover || exit-pill-touch.has-hover) ? 1.0 : 0.75;
            animate opacity { duration: ThemeTokens.motion-medium; }
            animate background { duration: ThemeTokens.motion-fast; }
            accessible-role: button;
            accessible-label: root.exit-label;

            exit-pill-touch := TouchArea {
                clicked => { root.exit(); }
            }

            exit-pill-layout := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                Image {
                    source: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
                    width: 14px;
                    height: 14px;
                    colorize: ThemeTokens.text;
                    image-fit: contain;
                    vertical-alignment: center;
                }

                Text {
                    text: root.exit-label;
                    color: ThemeTokens.text;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Bottom-hover reveal zone (touch-friendly)
    bottom-zone := TouchArea {
        x: (parent.width - capsule.width) / 2 - 20px;
        y: parent.height - 88px;
        width: capsule.width + 40px;
        height: 88px;

        capsule := Rectangle {
            x: 20px;
            y: parent.height - self.height - 20px;
            width: capsule-layout.preferred-width;
            height: 44px;
            border-radius: ThemeTokens.overlay-radius;
            background: ThemeTokens.layer-elevated;
            border-width: 1px;
            border-color: ThemeTokens.stroke;
            drop-shadow-blur: ThemeTokens.overlay-shadow-blur;
            drop-shadow-offset-y: ThemeTokens.overlay-shadow-offset-y;
            drop-shadow-color: ThemeTokens.overlay-shadow;
            opacity: (bottom-zone.has-hover || bottom-zone.pressed) ? 1.0 : 0.85;
            animate opacity { duration: ThemeTokens.motion-medium; }

            TouchArea {}

            capsule-layout := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                IconButton {
                    icon: @image-url("../../../../assets/icons/chevron_left_20_regular.svg");
                    tooltip: root.prev-label;
                    enabled: root.can-prev;
                    clicked => { root.prev(); }
                }

                Text {
                    text: root.page-info;
                    color: ThemeTokens.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                IconButton {
                    icon: @image-url("../../../../assets/icons/chevron_right_20_regular.svg");
                    tooltip: root.next-label;
                    enabled: root.can-next;
                    clicked => { root.next(); }
                }

                if root.show-zoom : Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: ThemeTokens.divider;
                }

                if root.show-zoom : IconButton {
                    icon: @image-url("../../../../assets/icons/zoom_out_20_regular.svg");
                    tooltip: root.zoom-out-label;
                    clicked => { root.zoom-out(); }
                }

                if root.show-zoom : IconButton {
                    icon: @image-url("../../../../assets/icons/zoom_in_20_regular.svg");
                    tooltip: root.zoom-in-label;
                    clicked => { root.zoom-in(); }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: ThemeTokens.divider;
                }

                IconButton {
                    icon: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
                    tooltip: root.exit-label;
                    clicked => { root.exit(); }
                }
            }
        }
    }
}
