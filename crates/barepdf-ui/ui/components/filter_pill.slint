import { ThemeTokens } from "../tokens.slint";

export component FilterPill inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    height: 24px;
    border-radius: ThemeTokens.control-radius;
    background: root.active ? ThemeTokens.selection
        : (touch.pressed ? ThemeTokens.control-pressed : (touch.has-hover ? ThemeTokens.control-hover : ThemeTokens.control));
    border-width: 1px;
    border-color: root.active ? ThemeTokens.accent : ThemeTokens.stroke;
    animate background { duration: ThemeTokens.motion-fast; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            color: ThemeTokens.text;
            font-size: 11px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
