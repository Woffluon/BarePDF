import { LineEdit } from "std-widgets.slint";
import { ThemeTokens } from "../tokens.slint";
import { TextButton } from "./button.slint";
import { IconButton } from "./icon_button.slint";

export component SearchBar inherits Rectangle {
    in-out property <string> query: "";
    in property <string> match_counter: "";
    in property <bool> case_sensitive: false;
    in property <bool> whole_word: false;
    in property <bool> has_matches: false;

    in property <string> placeholder: "Find in document...";

    callback query_changed(string);
    callback next_clicked();
    callback prev_clicked();
    callback close_clicked();
    callback toggle_case();
    callback toggle_whole_word();

    public function focus-input() {
        input.focus();
    }

    height: 44px;
    width: 480px;
    border-radius: ThemeTokens.overlay-radius;
    background: ThemeTokens.layer-elevated;
    border-width: 1px;
    border-color: ThemeTokens.stroke;
    drop-shadow-blur: ThemeTokens.overlay-shadow-blur;
    drop-shadow-offset-y: ThemeTokens.overlay-shadow-offset-y;
    drop-shadow-color: ThemeTokens.overlay-shadow;

    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: space-between;

        input := LineEdit {
            horizontal-stretch: 1;
            text <=> root.query;
            placeholder-text: root.placeholder;
            edited => { root.query_changed(self.text); }
            accepted => { root.next_clicked(); }
        }

        if root.match_counter != "" : Text {
            text: root.match_counter;
            color: root.has_matches ? ThemeTokens.text-muted : ThemeTokens.danger;
            font-size: 12px;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 4px;
            TextButton {
                text: "↑";
                compact: true;
                clicked => { root.prev_clicked(); }
            }
            TextButton {
                text: "↓";
                compact: true;
                clicked => { root.next_clicked(); }
            }
        }

        Rectangle { width: 1px; background: ThemeTokens.divider; }

        HorizontalLayout {
            spacing: 4px;
            TextButton {
                text: "Aa";
                compact: true;
                active: root.case_sensitive;
                clicked => { root.toggle_case(); }
            }
            TextButton {
                text: "W";
                compact: true;
                active: root.whole_word;
                clicked => { root.toggle_whole_word(); }
            }
        }

        Rectangle { width: 1px; background: ThemeTokens.divider; }

        IconButton {
            icon: @image-url("../../../../assets/icons/dismiss_20_regular.svg");
            tooltip: "Close";
            clicked => { root.close_clicked(); }
        }
    }
}
