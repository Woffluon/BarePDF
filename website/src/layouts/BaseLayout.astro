---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
}

const {
  title = 'BarePDF: Bare, Fast, Yours.',
  description = 'Bare, Fast, Yours. Ultra-lightweight open-source PDF reader for Windows 10/11 built with Rust and PDFium.',
  currentPath = '',
  ogImage,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://woffluon.github.io');
const resolvedOgImage = ogImage || `${baseUrl}/images/banner-white.png`;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon & Manifest -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="alternate icon" href={`${baseUrl}/favicon.ico`} />
    <link rel="manifest" href={`${baseUrl}/site.webmanifest`} />
    <meta name="theme-color" content="#f69423" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <Header currentPath={currentPath} />

    <main id="main-content" class="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
