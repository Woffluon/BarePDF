---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import BenchmarkSection from '../components/BenchmarkSection.astro';
import DownloadMetricCard from '../components/DownloadMetricCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Philosophy from '../components/Philosophy.astro';
import CommitList from '../components/CommitList.astro';
import { getLatestRelease, getRecentCommits, getDownloadMetrics } from '../lib/github';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch latest verified release, recent commits, and download metrics
const latestRelease = await getLatestRelease();
const recentCommits = await getRecentCommits(5);
const downloadMetrics = await getDownloadMetrics();
---

<BaseLayout
  title="BarePDF: Bare, Fast, Yours."
  description="BarePDF is an open-source, resource-bounded PDF reader for Windows 10/11 built with Rust and Google PDFium."
  currentPath={`${baseUrl}/`}
>
  <Hero release={latestRelease} />

  <AppScreenshot />

  <div class="container">
    <DownloadMetricCard metrics={downloadMetrics} />
  </div>

  <BenchmarkSection />

  <Philosophy />

  <FeatureGrid />

  <section class="home-activity-section" aria-labelledby="activity-heading">
    <div class="container">
      <div class="activity-header">
        <div>
          <span class="badge badge-accent">
            <span data-i18n data-en="Live Git Stream" data-tr="Canlı Git Akışı">Live Git Stream</span>
          </span>
          <h2 id="activity-heading" class="activity-title" data-i18n data-en="Recent Repository Activity" data-tr="Son Geliştirme Hareketleri">
            Recent Repository Activity
          </h2>
          <p class="activity-subtitle" data-i18n
            data-en="Synchronized directly from the default branch on every site deployment."
            data-tr="Her site dağıtımında varsayılan daldan doğrudan güncellenir.">
            Synchronized directly from the default branch on every site deployment.
          </p>
        </div>
        <a href={`${baseUrl}/changelog`} class="btn btn-secondary">
          <span data-i18n data-en="View Full Changelog" data-tr="Tüm Değişiklikleri Gör">View Full Changelog</span>
        </a>
      </div>

      <CommitList commits={recentCommits} />
    </div>
  </section>

  <section class="docs-cta-section" aria-labelledby="docs-cta-title">
    <div class="container docs-cta-box">
      <div class="cta-text">
        <span class="badge badge-accent">
          <span data-i18n data-en="Documentation & Guides" data-tr="Belgeler ve Rehberler">Documentation & Guides</span>
        </span>
        <h2 id="docs-cta-title" class="cta-title" data-i18n data-en="Explore the Technical Guides" data-tr="Teknik Rehberleri İnceleyin">
          Explore the Technical Guides
        </h2>
        <p class="cta-desc" data-i18n
          data-en="Whether you are configuring desktop shortcuts or compiling from source with Cargo and PDFium, consult our documentation."
          data-tr="İster klavye kısayollarını özelleştirin, ister Cargo ve PDFium ile kaynaktan derleme yapın; kılavuzlarımıza göz atın.">
          Whether you are configuring desktop shortcuts or compiling from source with Cargo and PDFium, consult our documentation.
        </p>
      </div>

      <div class="cta-buttons">
        <a href={`${baseUrl}/docs/user/getting-started`} class="btn btn-primary">
          <span data-i18n data-en="User Guide" data-tr="Kullanıcı Rehberi">User Guide</span>
        </a>
        <a href={`${baseUrl}/docs/developer/building`} class="btn btn-secondary">
          <span data-i18n data-en="Developer Guide" data-tr="Geliştirici Rehberi">Developer Guide</span>
        </a>
        <a href={`${baseUrl}/docs/user/keyboard-shortcuts`} class="btn btn-secondary">
          <span data-i18n data-en="Shortcuts Reference" data-tr="Kısayol Başvurusu">Shortcuts Reference</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-activity-section {
    padding: 3rem 0 4.5rem;
  }

  .activity-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    gap: 1.5rem;
  }

  .activity-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    letter-spacing: -0.03em;
  }

  .activity-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .docs-cta-section {
    padding: 1rem 0 5rem;
  }

  .docs-cta-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.75rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .cta-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-top: 0.6rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .cta-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 540px;
    line-height: 1.55;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  @media (max-width: 800px) {
    .activity-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .docs-cta-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem;
    }
    .cta-buttons {
      width: 100%;
    }
    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>
