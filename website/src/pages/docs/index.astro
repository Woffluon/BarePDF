---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const allDocs = await getCollection('docs');

const userDocs = allDocs.filter((d) => d.data.category === 'user').sort((a, b) => a.data.order - b.data.order);
const devDocs = allDocs.filter((d) => d.data.category === 'developer').sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="BarePDF Documentation"
  description="Official User and Developer Documentation for BarePDF desktop reader."
  currentPath={`${baseUrl}/docs`}
>
  <section class="docs-landing-header">
    <div class="container header-container">
      <h1 class="page-title">BarePDF Documentation</h1>
      <p class="page-subtitle">
        Everything you need to install, configure, read, build, and contribute to BarePDF.
      </p>
    </div>
  </section>

  <section class="docs-landing-body">
    <div class="container">
      <div class="docs-guides-grid">
        <!-- User Documentation Card -->
        <div class="guide-card">
          <div class="guide-card-header">
            <div class="card-icon icon-user">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div>
              <h2 class="card-title">User Documentation</h2>
              <p class="card-subtitle">Guides for installing, configuring, and reading with BarePDF.</p>
            </div>
          </div>

          <ul class="docs-links-list">
            {userDocs.map((doc) => (
              <li>
                <a href={`${baseUrl}/docs/${doc.id}`} class="doc-link-item">
                  <span class="doc-link-title">{doc.data.title}</span>
                  <span class="doc-link-desc">{doc.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Developer Documentation Card -->
        <div class="guide-card">
          <div class="guide-card-header">
            <div class="card-icon icon-dev">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div>
              <h2 class="card-title">Developer Guide</h2>
              <p class="card-subtitle">Technical documentation for building, testing, and contributing.</p>
            </div>
          </div>

          <ul class="docs-links-list">
            {devDocs.map((doc) => (
              <li>
                <a href={`${baseUrl}/docs/${doc.id}`} class="doc-link-item">
                  <span class="doc-link-title">{doc.data.title}</span>
                  <span class="doc-link-desc">{doc.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .docs-landing-header {
    padding: 4rem 0 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    max-width: 680px;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .docs-landing-body {
    padding: 3.5rem 0 5rem;
  }

  .docs-guides-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .guide-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-md);
  }

  .guide-card-header {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .card-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .card-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .docs-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-links-list li {
    margin-bottom: 0.75rem;
  }

  .doc-link-item {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .doc-link-item:hover {
    border-color: var(--color-accent-border);
    transform: translateX(2px);
    text-decoration: none;
  }

  .doc-link-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .doc-link-desc {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
  }

  @media (max-width: 768px) {
    .docs-guides-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
