---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import CommitList from '../components/CommitList.astro';
import { getLatestRelease, getRecentCommits } from '../lib/github';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const release = await getLatestRelease();
const commits = await getRecentCommits(30);
---

<BaseLayout
  title="Changelog & Activity — BarePDF"
  description="View recent GitHub release notes and development commit activity for BarePDF."
  currentPath={`${baseUrl}/changelog`}
>
  <section class="changelog-header">
    <div class="container header-container">
      <h1 class="page-title">Changelog & Activity</h1>
      <p class="page-subtitle">
        Track recent releases, feature implementations, and Git development activity.
      </p>
    </div>
  </section>

  <section class="changelog-body">
    <div class="container">
      <div class="section-block">
        <h2 class="block-heading">Latest Published Release</h2>
        <ReleaseCard release={release} />
      </div>

      <div class="section-block">
        <div class="block-header">
          <h2 class="block-heading">Recent Git Commits</h2>
          <span class="commit-count-badge">{commits.length} Recent Commits</span>
        </div>

        <CommitList commits={commits} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .changelog-header {
    padding: 3.5rem 0 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    max-width: 640px;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .changelog-body {
    padding: 3.5rem 0 5rem;
  }

  .section-block {
    margin-bottom: 3.5rem;
  }

  .block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .block-heading {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
  }

  .commit-count-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-dim);
    padding: 0.2rem 0.6rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }
</style>
