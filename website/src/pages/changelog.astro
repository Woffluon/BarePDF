---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import CommitList from '../components/CommitList.astro';
import { getLatestRelease, getRecentCommits } from '../lib/github';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const release = await getLatestRelease();
const commits = await getRecentCommits(30);
const hasReleaseMetadata = release.state === 'published';
---

<BaseLayout
  title="Changelog & Activity: BarePDF"
  description="View recent GitHub release notes and development commit activity for BarePDF."
  currentPath={`${baseUrl}/changelog`}
>
  <section class="changelog-header">
    <div class="container header-container">
      <span class="badge badge-accent">
        <span data-i18n data-en="Development Stream" data-tr="Geliştirme Akışı">Development Stream</span>
      </span>
      <h1 class="page-title" data-i18n data-en="Changelog & Activity" data-tr="Değişiklikler ve Hareketler">Changelog & Activity</h1>
      <p class="page-subtitle" data-i18n
        data-en="Track published releases, feature implementations, and default-branch commit history."
        data-tr="Yayımlanan sürümleri, özellik geliştirmelerini ve varsayılan dalın commit geçmişini takip edin.">
        Track published releases, feature implementations, and default-branch commit history.
      </p>
    </div>
  </section>

  <section class="changelog-body">
    <div class="container">
      <div class="section-block">
        <div class="block-header">
          <h2 class="block-heading" data-i18n
            data-en={hasReleaseMetadata ? 'Latest Published Release' : 'Current Build Version'}
            data-tr={hasReleaseMetadata ? 'Son Yayımlanan Sürüm' : 'Mevcut Derleme Sürümü'}>
            {hasReleaseMetadata ? 'Latest Published Release' : 'Current Build Version'}
          </h2>
        </div>
        <ReleaseCard release={release} />
      </div>

      <div class="section-block">
        <div class="block-header">
          <h2 class="block-heading" data-i18n data-en="Recent Git Commits" data-tr="Son Git Kayıtları">Recent Git Commits</h2>
          <span class="commit-count-badge">{commits.length} Recent Commits</span>
        </div>

        <CommitList commits={commits} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .changelog-header {
    padding: 3.5rem 0 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  .changelog-body {
    padding: 3.5rem 0 5rem;
  }

  .section-block {
    margin-bottom: 3.5rem;
  }

  .block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .block-heading {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .commit-count-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-dim);
    padding: 0.2rem 0.6rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
  }
</style>
