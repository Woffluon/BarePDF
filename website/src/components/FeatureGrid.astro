  id: string;
  title: string;
  trTitle: string;
  tagline: string;
  trTagline: string;
  description: string;
  trDescription: string;
  badge?: string;
  trBadge?: string;
  paths: readonly string[];
}

const features: readonly FeatureItem[] = [
  {
    id: 'tools',
    title: 'Merge, Split, Reorder & Crop Tools',
    trTitle: 'Birleştirme, Bölme, Sıralama ve Kırpma Araçları',
    tagline: 'Document assembly',
    trTagline: 'Belge düzenleme',
    description: 'Assemble multi-file documents, extract page intervals, reorder pages, or crop document margins to eliminate unwanted borders. All processing runs entirely on your local CPU.',
    trDescription: 'Çok dosyalı belgeleri birleştirin, sayfa aralıklarını ayıklayın, sayfaları yeniden sıralayın veya istenmeyen kenar boşluklarını kırpın. Tüm işlemler tamamen yerel işlemcinizde çalışır.',
    badge: 'Page Tools',
    trBadge: 'Sayfa Araçları',
