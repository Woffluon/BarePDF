---
interface FeatureItem {
  id: string;
  title: string;
  trTitle: string;
  tagline: string;
  trTagline: string;
  description: string;
  trDescription: string;
  badge?: string;
  trBadge?: string;
  codeAnchor: string;
}

const features: readonly FeatureItem[] = [
  {
    id: 'tools',
    title: 'Merge, Split, Rotate & Page Tools',
    trTitle: 'Birleştirme, Bölme, Döndürme ve Sayfa Araçları',
    tagline: 'Local Processing',
    trTagline: 'Yerel İşlem',
    description: 'Reorder pages, merge multi-file collections, extract intervals, and rotate orientations. Runs entirely via local CPU algorithms inside your process.',
    trDescription: 'Sayfaları yeniden sıralayın, çoklu dosyaları birleştirin, aralıkları ayıklayın ve yönleri döndürün. Tamamen yerel CPU algoritmalarıyla çalışır.',
    badge: 'Local CPU',
    trBadge: 'Yerel CPU',
    codeAnchor: 'crates/barepdf-pdf/src/operations.rs',
  },
  {
    id: 'annotations',
    title: 'Glyph Highlights, Ink Strokes & Stamp Notes',
    trTitle: 'Metin Vurguları, Çizimler ve Damga Notları',
    tagline: 'Vector Layer',
    trTagline: 'Vektörel Katman',
    description: 'Highlight text with glyph-accurate vector coordinates, draw ink lines with full undo/redo stack, and place typewriter text annotations on any page.',
    trDescription: 'Glif duyarlı vektörel koordinatlarla metin vurgulayın, geri/ileri alma geçmişli çizimler yapın ve sayfalara daktilo notları ekleyin.',
    badge: 'Annotations',
    trBadge: 'Notlar',
    codeAnchor: 'crates/barepdf-core/src/annotations.rs',
  },
  {
    id: 'hud',
    title: 'Keyboard-Driven Command Palette (Ctrl+K)',
    trTitle: 'Klavye Odaklı Komut Paleti (Ctrl+K)',
    tagline: 'Quick Actions',
    trTagline: 'Hızlı Eylemler',
    description: 'Jump to specific page numbers, toggle paper reading tints, switch view modes, or trigger tools without moving your hands away from the keyboard.',
    trDescription: 'Klavyeden elinizi kaldırmadan sayfa numaralarına atlayın, kâğıt tonlarını değiştirin, okuma modlarını ayarlayın veya araçları çalıştırın.',
    badge: 'Ctrl+K HUD',
    trBadge: 'Ctrl+K HUD',
    codeAnchor: 'crates/barepdf-ui',
  },
  {
    id: 'modes',
    title: 'Four Dedicated Layout Modes',
    trTitle: 'Dört Farklı Okuma Modu',
    tagline: 'Viewport Layouts',
    trTagline: 'Ekran Düzenleri',
    description: 'Continuous vertical scrolling, focused single-page view, two-page side-by-side spread, and cover-aware book view layout.',
    trDescription: 'Sürekli dikey kaydırma, odaklanmış tek sayfa, yan yana iki sayfa ve kapak uyumlu kitap görünümü.',
    badge: 'Reading Modes',
    trBadge: 'Okuma Modları',
    codeAnchor: 'crates/barepdf-core/src/layout.rs',
  },
  {
    id: 'tints',
    title: 'Calibrated Paper Reading Tints',
    trTitle: 'Ayarlanmış Kâğıt Okuma Tonları',
    tagline: 'Visual Ergonomics',
    trTagline: 'Görsel Ergonomi',
    description: 'Sepia for long daytime reading sessions, dark night tones for low-light rooms, Amber warmth, and high-contrast color inversion.',
    trDescription: 'Uzun gündüz okumaları için Sepya, loş ortamlar için Gece, Kehribar sıcaklığı ve yüksek kontrastlı renk tersine çevirme.',
    badge: 'Eye Comfort',
    trBadge: 'Göz Konforu',
    codeAnchor: 'crates/barepdf-render',
  },
  {
    id: 'print-shell',
    title: 'Native Win32 Print & Shell Thumbnails',
    trTitle: 'Yerel Win32 Yazdırma ve Gezgin Önizlemeleri',
    tagline: 'Windows Shell',
    trTagline: 'Windows Kabuğu',
    description: 'Direct high-resolution printing pipeline via native Win32 printer dialogs. Dedicated shell provider generates crisp PDF thumbnails inside Windows Explorer.',
    trDescription: 'Yerel Win32 yazdırma pencereleri üzerinden doğrudan yüksek çözünürlüklü yazdırma. Özel kabuk eklentisi Dosya Gezgini içinde net PDF küçük resimleri üretir.',
    badge: 'Win32 Native',
    trBadge: 'Win32 Yerel',
    codeAnchor: 'crates/barepdf-thumbnail',
  },
];
---

<section class="features-section" aria-labelledby="features-heading">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        <span data-i18n data-en="Verified Capabilities" data-tr="Doğrulanmış Yetenekler">Verified Capabilities</span>
      </span>
      <h2 id="features-heading" class="section-title" data-i18n data-en="Fast, Focused, Verified Document Tooling" data-tr="Hızlı, Odaklı, Doğrulanmış Belge Araçları">
        Fast, Focused, Verified Document Tooling
      </h2>
      <p class="section-subtitle" data-i18n
        data-en="Every feature runs locally in your machine process without requiring external cloud subscriptions, telemetry trackers, or background sync services."
        data-tr="Her bir özellik harici bulut aboneliği, telemetri takipçisi veya arka plan eşitleme servisi gerektirmeden doğrudan bilgisayarınızda çalışır.">
        Every feature runs locally in your machine process without requiring external cloud subscriptions, telemetry trackers, or background sync services.
      </p>
    </div>

    <div class="features-grid">
      {features.map((f) => (
        <article class="feature-card">
          <div class="feature-card-header">
            <span class="feature-tagline" data-i18n data-en={f.tagline} data-tr={f.trTagline}>
              {f.tagline}
            </span>
            {f.badge && (
              <span class="badge" data-i18n data-en={f.badge} data-tr={f.trBadge}>
                {f.badge}
              </span>
            )}
          </div>

          <h3 class="feature-title" data-i18n data-en={f.title} data-tr={f.trTitle}>
            {f.title}
          </h3>

          <p class="feature-desc" data-i18n data-en={f.description} data-tr={f.trDescription}>
            {f.description}
          </p>

          <div class="feature-footer">
            <span class="code-ref"><code>{f.codeAnchor}</code></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 3rem 0 4.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .feature-tagline {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .feature-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .feature-desc {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .feature-footer {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.75rem;
  }

  .code-ref code {
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
