---

<section class="features-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" data-i18n data-en="Engineered for Fast, Focused Reading" data-tr="Hızlı ve odaklı okuma için tasarlandı">
        Engineered for Fast, Focused Reading
      </h2>
      <p class="section-subtitle" data-i18n
        data-en="Built in Rust with Slint and Google PDFium. Demand-driven rendering, dedicated document tools, and verified zero background telemetry."
        data-tr="Rust, Slint ve Google PDFium ile geliştirildi. Talep odaklı işleme, özel belge araçları ve doğrulanmış sıfır telemetri.">
        Built in Rust with Slint and Google PDFium. Demand-driven rendering, dedicated document tools, and verified zero background telemetry.
      </p>
    </div>

    <div class="bento-grid">
      {features.map((f, index) => {
        const isFeatured = index === 0 || index === 1 || index === 6;
        return (
          <div class:list={['feature-card', `feature-${f.id}`, { featured: isFeatured }]}>
            <div class="card-top">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {f.paths.map((d) => <path d={d}></path>)}
                </svg>
              </div>
              {f.badge && (
                <span class="feature-badge" data-i18n data-en={f.badge} data-tr={f.trBadge}>
                  {f.badge}
                </span>
              )}
            </div>

            <div class="card-content">
              <span class="feature-tagline" data-i18n data-en={f.tagline} data-tr={f.trTagline}>
                {f.tagline}
              </span>
              <h3 class="feature-title" data-i18n data-en={f.title} data-tr={f.trTitle}>
                {f.title}
              </h3>
              <p class="feature-desc" data-i18n data-en={f.description} data-tr={f.trDescription}>
                {f.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 4.5rem 0 3.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* Bento 12-column layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .feature-card:hover {
    border-color: var(--color-accent-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Layout distribution for 7 items */
  .feature-tools {
    grid-column: span 6;
  }

  .feature-annotations {
    grid-column: span 6;
  }

  .feature-hud {
    grid-column: span 4;
  }

  .feature-modes {
    grid-column: span 4;
  }

  .feature-tints {
    grid-column: span 4;
  }

  .feature-print-shell {
    grid-column: span 6;
  }

  .feature-zero-telemetry {
    grid-column: span 6;
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
    border-color: var(--color-accent-border);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .feature-badge {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
  }

  .feature-zero-telemetry .feature-badge {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-accent-hover);
    font-weight: 700;
  }

  .card-content {
    display: flex;
    flex-direction: column;
  }

  .feature-tagline {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-dim);
    margin-bottom: 0.375rem;
  }

  .feature-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .feature-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .feature-tools,
    .feature-annotations,
    .feature-print-shell,
    .feature-zero-telemetry {
      grid-column: span 6;
    }

    .feature-hud,
    .feature-modes,
    .feature-tints {
      grid-column: span 12;
    }
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .feature-tools,
    .feature-annotations,
    .feature-hud,
    .feature-modes,
    .feature-tints,
    .feature-print-shell,
    .feature-zero-telemetry {
      grid-column: span 1;
    }

    .section-title {
      font-size: 1.85rem;
    }
  }
</style>
