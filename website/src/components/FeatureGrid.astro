---
const features = [
  {
    title: 'Ultra Low Overhead',
    description: 'Maintains under 60MB idle RAM usage and near 0% idle CPU for instant, non-intrusive PDF reading.',
    icon: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>`
  },
  {
    title: 'Demand-Driven Rendering',
    description: 'LRU byte-budgeted memory cache (96MB/256MB) and generation token cancellation prevent scroll lag on huge files.',
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>`
  },
  {
    title: 'Google PDFium Engine',
    description: 'Industry-standard rendering fidelity, text extraction, font metric parsing, and security compliance.',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>`
  },
  {
    title: 'Modern Slint Desktop UX',
    description: 'Native dark and light theme integration, clean high-DPI crisp vector controls, and responsive toolbars.',
    icon: `<path d="M12 2v20M2 12h20"></path>`
  },
  {
    title: 'Flexible Viewing Modes',
    description: 'Continuous vertical scrolling, Single Page, Two Page Spread, Book Mode, Full Screen (F11), and Presentation (F5).',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>`
  },
  {
    title: 'Native Windows Integration',
    description: 'Clean setup installer or zero-install portable ZIP. Registers safely in Windows Default Apps settings without registry hacks.',
    icon: `<path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>`
  }
];
---

<section class="features-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Engineered for Fast, Focused Reading</h2>
      <p class="section-subtitle">
        Built from the ground up in Rust for performance, stability, and minimalist desktop usability.
      </p>
    </div>

    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon}></svg>
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 4rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .feature-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .feature-card:hover {
    border-color: var(--color-accent-border);
    transform: translateY(-2px);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .feature-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
