---
import type { DownloadMetrics } from '../lib/github';

interface Props {
  metrics: DownloadMetrics | null;
  compact?: boolean;
}

const { metrics, compact = false } = Astro.props;
---

{metrics && (
  <section class:list={['download-metric-card', { compact }]} aria-labelledby="metrics-title">
    <div class="metric-header">
      <div class="metric-title-group">
        <div class="metric-badge-row">
          <span class="badge badge-success">
            <span data-i18n data-en="Verified Zero Telemetry" data-tr="Doğrulanmış Sıfır Telemetri">Verified Zero Telemetry</span>
          </span>
          <span class="metric-subtag" data-i18n data-en="GitHub API Live Asset Metrics" data-tr="GitHub API Canlı Dosya Verileri">
            GitHub API Live Asset Metrics
          </span>
        </div>
        <h3 id="metrics-title" class="metric-title" data-i18n data-en="Release Distribution Metrics" data-tr="Sürüm Dağıtım Verileri">
          Release Distribution Metrics
        </h3>
      </div>
    </div>

    <div class="metric-numbers-grid">
      <div class="metric-stat">
        <span class="stat-number">{metrics.totalDownloads.toLocaleString()}</span>
        <span class="stat-label" data-i18n data-en="Total Asset Downloads" data-tr="Toplam Dosya İndirmesi">Total Asset Downloads</span>
      </div>
      <div class="metric-stat">
        <span class="stat-number">{metrics.installerDownloads.toLocaleString()}</span>
        <span class="stat-label" data-i18n data-en="Setup Installer (.exe)" data-tr="Kurulum Paketi (.exe)">Setup Installer (.exe)</span>
      </div>
      <div class="metric-stat">
        <span class="stat-number">{metrics.portableDownloads.toLocaleString()}</span>
        <span class="stat-label" data-i18n data-en="Portable Archive (.zip)" data-tr="Taşınabilir Paket (.zip)">Portable Archive (.zip)</span>
      </div>
      <div class="metric-stat highlight">
        <span class="stat-number">0</span>
        <span class="stat-label" data-i18n data-en="Background Tracking Calls" data-tr="Arka Plan Takip Çağrısı">Background Tracking Calls</span>
      </div>
    </div>

    <p class="metric-explanation" data-i18n
      data-en="Asset numbers reflect the raw GitHub release asset download counter at site build time. They represent binary retrievals (including CI runners and repeated downloads), not unique active users. BarePDF transmits 0 analytics pings, sets 0 tracking cookies, and runs offline by default."
      data-tr="İndirme sayıları site derleme anında GitHub API tarafından bildirilen ham dosya indirme sayaçlarıdır. Tekil kullanıcıyı değil, dosya çekme sayısını (CI çalıştırıcıları ve tekrarlar dahil) temsil eder. BarePDF varsayılan olarak tamamen çevrimdışıdır; sıfır takip çerezi ve sıfır analitik çağrısı ile çalışır.">
      Asset numbers reflect the raw GitHub release asset download counter at site build time. They represent binary retrievals (including CI runners and repeated downloads), not unique active users. BarePDF transmits 0 analytics pings, sets 0 tracking cookies, and runs offline by default.
    </p>
  </section>
)}

<style>
  .download-metric-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-sm);
    margin: 2.5rem 0;
  }

  .download-metric-card.compact {
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .metric-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .metric-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .metric-subtag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .metric-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .metric-numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: 1rem;
  }

  .metric-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.1;
    font-family: var(--font-mono);
    color: var(--color-text);
    letter-spacing: -0.03em;
  }

  .metric-stat.highlight .stat-number {
    color: var(--color-accent);
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .metric-explanation {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-dim);
    margin: 0;
  }

  @media (max-width: 768px) {
    .download-metric-card {
      padding: 1.25rem;
    }

    .metric-numbers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }
  }
</style>
