---
import type { GitHubRelease } from '../lib/github';

interface Props {
  release: GitHubRelease;
}

const { release } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const installerAsset = release.assets.find((a) => a.type === 'installer');
const hasReleaseMetadata = release.state === 'published';
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container hero-container">
    <div class="hero-badge">
      <span class="badge badge-accent">
        <span data-i18n data-en={hasReleaseMetadata ? `Version ${release.tag}` : `Build ${release.tag}`} data-tr={hasReleaseMetadata ? `Sürüm ${release.tag}` : `Derleme ${release.tag}`}>
          {hasReleaseMetadata ? `Version ${release.tag}` : `Build ${release.tag}`}
        </span>
      </span>
      <span class="hero-tagline">Windows 10 / 11 · 64-bit · Open Source</span>
    </div>

    <h1 id="hero-heading" class="hero-title">
      <span data-i18n data-en="Bare. Fast. Yours." data-tr="Sade. Hızlı. Senin.">Bare. Fast. Yours.</span>
    </h1>

    <p class="hero-subtitle">
      <span data-i18n
        data-en="An offline, resource-bounded PDF reader built with Rust and Google PDFium. Zero telemetry, zero accounts, and zero cloud lock-in."
        data-tr="Rust ve Google PDFium ile geliştirilen, kaynak sınırları belirlenmiş çevrimdışı PDF okuyucu. Sıfır telemetri, sıfır hesap zorunluluğu, sıfır bulut bağımlılığı.">
        An offline, resource-bounded PDF reader built with Rust and Google PDFium. Zero telemetry, zero accounts, and zero cloud lock-in.
      </span>
    </p>

    <div class="hero-cta-group">
      {installerAsset ? (
        <a href={installerAsset.downloadUrl} rel="noopener noreferrer" class="btn btn-primary btn-hero">
          <span data-i18n data-en={`Download Setup (${release.tag})`} data-tr={`Kurulum Paketini İndir (${release.tag})`}>
            Download Setup ({release.tag})
          </span>
        </a>
      ) : (
        <a href={release.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-hero">
          <span data-i18n data-en="View Release on GitHub" data-tr="GitHub Sürümünü Aç">
            View Release on GitHub
          </span>
        </a>
      )}

      <a href={`${baseUrl}/download`} class="btn btn-secondary btn-hero">
        <span data-i18n data-en="Portable ZIP & Hashes" data-tr="Taşınabilir ZIP ve Doğrulama">
          Portable ZIP & Hashes
        </span>
      </a>

      <a href={`${baseUrl}/manifesto`} class="btn btn-secondary btn-hero">
        <span data-i18n data-en="Read Manifesto" data-tr="Bildiriyi Oku">
          Read Manifesto
        </span>
      </a>
    </div>

    <div class="hero-spec-strip" role="list" aria-label="Core Technical Guarantees">
      <div class="spec-item" role="listitem">
        <span class="spec-label" data-i18n data-en="Engine" data-tr="Motor">Engine</span>
        <strong class="spec-value">Google PDFium</strong>
      </div>
      <div class="spec-divider" aria-hidden="true"></div>
      <div class="spec-item" role="listitem">
        <span class="spec-label" data-i18n data-en="UI Framework" data-tr="Arayüz">UI Framework</span>
        <strong class="spec-value">Slint & Rust</strong>
      </div>
      <div class="spec-divider" aria-hidden="true"></div>
      <div class="spec-item" role="listitem">
        <span class="spec-label" data-i18n data-en="Memory" data-tr="Bellek">Memory</span>
        <strong class="spec-value">Byte-Bounded LRU</strong>
      </div>
      <div class="spec-divider" aria-hidden="true"></div>
      <div class="spec-item" role="listitem">
        <span class="spec-label" data-i18n data-en="Network" data-tr="Ağ">Network</span>
        <strong class="spec-value" data-i18n data-en="Offline by Default" data-tr="Varsayılan Çevrimdışı">Offline by Default</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 3.5rem 0 2.5rem;
    text-align: center;
  }

  .hero-container {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 640px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 2.75rem;
  }

  .btn-hero {
    padding: 0.75rem 1.4rem;
    font-size: 0.95rem;
  }

  .hero-spec-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .spec-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.84rem;
  }

  .spec-label {
    color: var(--color-text-dim);
  }

  .spec-value {
    color: var(--color-text);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .spec-divider {
    width: 1px;
    height: 12px;
    background-color: var(--color-border);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2.5rem 0 2rem;
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
    }
    .spec-divider {
      display: none;
    }
    .hero-spec-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
      padding: 1rem 1.25rem;
    }
  }
</style>
