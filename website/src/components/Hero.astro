---
import type { GitHubRelease } from '../lib/github';

interface Props {
  release: GitHubRelease;
}

const { release } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const installerAsset = release.assets.find((a) => a.type === 'installer');
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge">
      <span class="badge badge-success">Latest Release {release.tag}</span>
      <span class="hero-tagline">Windows 10 / 11 64-bit</span>
    </div>

    <h1 class="hero-title">
      Bare. Fast. Yours.
    </h1>

    <p class="hero-subtitle">
      A minimal, high-speed PDF reader for Windows built with Rust and PDFium. No ads, no tracking, and no bloat.
    </p>

    <div class="hero-cta-group">
      {installerAsset ? (
        <a href={installerAsset.downloadUrl} class="btn btn-primary btn-hero">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Setup Installer ({release.tag})</span>
        </a>
      ) : (
        <a href={`${baseUrl}/download`} class="btn btn-primary btn-hero">
          <span>Download BarePDF</span>
        </a>
      )}

      <a href={`${baseUrl}/download`} class="btn btn-secondary btn-hero">
        Portable ZIP & Checksums
      </a>

      <a href={`${baseUrl}/docs`} class="btn btn-secondary btn-hero">
        Documentation
      </a>
    </div>

    <div class="hero-meta-strip">
      <div class="meta-item">
        <span class="meta-label">Rendering:</span>
        <strong class="meta-value">Byte-Bounded</strong>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <span class="meta-label">Engine:</span>
        <strong class="meta-value">Google PDFium</strong>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <span class="meta-label">Privacy:</span>
        <strong class="meta-value">Zero Telemetry</strong>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <span class="meta-label">License:</span>
        <strong class="meta-value">Open Source (MIT)</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--color-accent-subtle) 0%, transparent 60%);
  }

  .hero-container {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    font-weight: 500;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 2.25rem;
    max-width: 720px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .btn-hero {
    padding: 0.85rem 1.6rem;
    font-size: 1rem;
  }

  .hero-meta-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 0.85rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  .meta-item {
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .meta-label {
    margin-right: 0.25rem;
  }

  .meta-value {
    color: var(--color-text);
    font-weight: 600;
  }

  .meta-divider {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-border-subtle);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 0 2.5rem;
    }
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-subtitle {
      font-size: 1.05rem;
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
    }
    .meta-divider {
      display: none;
    }
    .hero-meta-strip {
      border-radius: var(--radius-lg);
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
