---
const points = [
  {
    title: 'Zero Telemetry & Tracking',
    trTitle: 'Sıfır telemetri ve takip',
    description: 'No background tracking, analytics beacons, or phone-home requests. Your document reading activity is private.',
    trDescription: 'Arka plan takibi, analitik sinyali veya eve çağrı yok. Belgelerinizi nasıl okuduğunuz size ait.'
  },
  {
    title: 'No User Accounts Required',
    trTitle: 'Kullanıcı hesabı gerekmez',
    description: 'No email signups, paywalls, trial countdowns, or cloud subscription prompts. Download and open your PDFs.',
    trDescription: 'E-posta kaydı, ödeme duvarı, deneme sayacı veya bulut aboneliği yok. İndirin ve PDF’inizi açın.'
  },
  {
    title: 'No AI Clutter or Ads',
    trTitle: 'Yapay zekâ kalabalığı ve reklam yok',
    description: 'Focused strictly on fast PDF reading. Free of intrusive AI summarize popups, advertisements, or sponsored sidebars.',
    trDescription: 'Yalnızca hızlı PDF okumaya odaklanır. Zorlayıcı özet pencereleri, reklamlar ve sponsorlu kenar çubukları yok.'
  },
  {
    title: '100% Offline & Local Operation',
    trTitle: '%100 çevrimdışı ve yerel çalışma',
    description: 'Your documents never leave your computer. PDF parsing, bitmap rendering, and search happen locally.',
    trDescription: 'Belgeleriniz bilgisayarınızdan çıkmaz. PDF ayrıştırma, görüntüleme ve arama yerel olarak yapılır.'
  }
];
---

<section class="philosophy-section">
  <div class="container">
    <div class="philosophy-box">
      <div class="philosophy-header">
        <h2 class="philosophy-title" data-i18n data-en="Private & Minimalist by Principle" data-tr="İlke olarak özel ve yalın">Private & Minimalist by Principle</h2>
        <p class="philosophy-subtitle" data-i18n data-en="BarePDF is built around a clear open-source philosophy: software should respect user privacy and system resources." data-tr="BarePDF şu açık kaynak ilkesine dayanır: yazılım, kullanıcının gizliliğine ve sistem kaynaklarına saygı göstermelidir.">
          BarePDF is built around a clear open-source philosophy: software should respect user privacy and system resources.
        </p>
      </div>

      <div class="philosophy-grid">
        {points.map((item) => (
          <div class="philosophy-item">
            <div class="check-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <h3 class="item-title" data-i18n data-en={item.title} data-tr={item.trTitle}>{item.title}</h3>
              <p class="item-desc" data-i18n data-en={item.description} data-tr={item.trDescription}>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    padding: 3rem 0 5rem;
  }

  .philosophy-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .philosophy-header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .philosophy-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .philosophy-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .philosophy-item {
    display: flex;
    gap: 1rem;
  }

  .check-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background-color: var(--color-success-bg);
    color: var(--color-success);
    margin-top: 0.2rem;
  }

  .item-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }

  .item-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .philosophy-box {
      padding: 1.75rem;
    }
    .philosophy-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
