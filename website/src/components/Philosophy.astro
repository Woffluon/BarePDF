---
interface RefusalItem {
  number: string;
  refusal: string;
  trRefusal: string;
  explanation: string;
  trExplanation: string;
  codeSource: string;
}

const refusals: readonly RefusalItem[] = [
  {
    number: '01',
    refusal: 'No Background Telemetry or Tracking Beacons',
    trRefusal: 'Arka Plan Telemetrisi ve Takip İşaretçisi Yok',
    explanation: 'BarePDF contains 0 analytics SDKs, 0 user activity pings, and 0 identifier cookies. Reading activity stays entirely on your personal processor.',
    trExplanation: 'BarePDF içinde sıfır analitik kütüphanesi, sıfır etkinlik sinyali ve sıfır cihaz kimliği bulunur. Okuma hareketleriniz tamamen kişisel bilgisayarınızda kalır.',
    codeSource: 'crates/barepdf-platform-windows',
  },
  {
    number: '02',
    refusal: 'No Mandatory User Accounts or Cloud Sign-Ins',
    trRefusal: 'Zorunlu Kullanıcı Hesabı ve Bulut Girişi Yok',
    explanation: 'No email forms, subscription countdowns, paywalls, or cloud dependencies. When you launch BarePDF, you immediately open documents.',
    trExplanation: 'E-posta kaydı, abonelik sayacı, ödeme duvarı veya bulut zorunluluğu yok. BarePDF açıldığında doğrudan belgelerinizi görüntülersiniz.',
    codeSource: 'apps/barepdf/src/presentation/state.rs',
  },
  {
    number: '03',
    refusal: 'No In-App Advertisements or AI Summarization Upsells',
    trRefusal: 'Uygulama İçi Reklam ve Yapay Zekâ Pazarlaması Yok',
    explanation: 'The interface remains uncluttered. There are no sponsored banners, marketing sidebars, or intrusive modal dialogs urging you to upgrade to AI tiers.',
    trExplanation: 'Arayüz yalın kalır. Sponsorlu afişler, pazarlama kenar çubukları veya sizi ücretli yapay zekâ katmanlarına zorlayan pencereler yer almaz.',
    codeSource: 'crates/barepdf-ui',
  },
  {
    number: '04',
    refusal: 'Offline by Default Operation',
    trRefusal: 'Varsayılan Olarak Tamamen Çevrimdışı Çalışma',
    explanation: 'Document parsing, bitmap rendering, annotations, and page tools run strictly via local CPU instructions. Network connectivity is used only if you explicitly choose to check for updates.',
    trExplanation: 'Belge ayrıştırma, görüntü oluşturma, notlar ve sayfa araçları tamamen yerel CPU komutlarıyla çalışır. Ağ bağlantısı yalnızca güncellemeleri kontrol etmeyi açıkça seçerseniz kullanılır.',
    codeSource: 'apps/barepdf/src/infrastructure/update',
  },
];
---

<section class="philosophy-section" aria-labelledby="philosophy-heading">
  <div class="container">
    <div class="philosophy-box">
      <div class="philosophy-header">
        <span class="badge badge-accent">
          <span data-i18n data-en="Engineering Philosophy" data-tr="Mühendislik Felsefesi">Engineering Philosophy</span>
        </span>
        <h2 id="philosophy-heading" class="philosophy-title" data-i18n data-en="What BarePDF Deliberately Does Not Do" data-tr="BarePDF’in Bilinçli Olarak Yapmadıkları">
          What BarePDF Deliberately Does Not Do
        </h2>
        <p class="philosophy-subtitle" data-i18n
          data-en="Modern document tools often extract user attention and system resources to feed cloud platforms. BarePDF is built on an explicit series of architectural refusals."
          data-tr="Günümüz belge araçları, bulut platformlarını beslemek için kullanıcı dikkatini ve sistem kaynaklarını tüketir. BarePDF bilinçli bir mimari ret dizisi üzerine inşa edilmiştir.">
          Modern document tools often extract user attention and system resources to feed cloud platforms. BarePDF is built on an explicit series of architectural refusals.
        </p>
      </div>

      <div class="refusals-grid">
        {refusals.map((item) => (
          <div class="refusal-item">
            <div class="refusal-top">
              <span class="refusal-num">{item.number}</span>
              <span class="refusal-source"><code>{item.codeSource}</code></span>
            </div>
            <h3 class="refusal-title" data-i18n data-en={item.refusal} data-tr={item.trRefusal}>{item.refusal}</h3>
            <p class="refusal-desc" data-i18n data-en={item.explanation} data-tr={item.trExplanation}>{item.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    padding: 2.5rem 0 4rem;
  }

  .philosophy-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .philosophy-header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .philosophy-title {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .philosophy-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .refusals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .refusal-item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .refusal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .refusal-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .refusal-source code {
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .refusal-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .refusal-desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .philosophy-box {
      padding: 1.5rem;
    }
    .refusals-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
