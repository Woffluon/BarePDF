---
interface RefusalItem {
  number: string;
  refusal: string;
  trRefusal: string;
  explanation: string;
  trExplanation: string;
  codeSource: string;
}

const refusals: readonly RefusalItem[] = [
  {
    number: '01',
    refusal: 'No Telemetry or Analytics SDKs',
    trRefusal: "Telemetri ve Analitik SDK'sı Yok",
    explanation: 'Zero analytics libraries, zero usage pings, and zero tracking identifiers. Reading state and file paths remain on your local machine.',
    trExplanation: 'Sıfır analitik kütüphanesi, sıfır kullanım sinyali ve sıfır takip kimliği. Okuma durumu ve dosya yolları yalnızca yerel makinenizde kalır.',
    codeSource: 'crates/barepdf-platform-windows',
  },
  {
    number: '02',
    refusal: 'No Accounts or Login Gates',
    trRefusal: 'Hesap veya Oturum Engeli Yok',
    explanation: 'No registration prompts, license servers, or subscription timers. Launching BarePDF opens local files directly.',
    trExplanation: 'Kayıt ekranları, lisans sunucuları veya abonelik sayaçları bulunmaz. BarePDF açıldığında doğrudan yerel dosyaları görüntüler.',
    codeSource: 'apps/barepdf/src/presentation/state.rs',
  },
  {
    number: '03',
    refusal: 'No Ads or AI Upsell Prompts',
    trRefusal: 'Reklam ve Yapay Zekâ Satış İstemi Yok',
    explanation: 'No promotional banners, sidebar upsells, or modal upgrade dialogs. Every pixel of interface space serves document reading and page tools.',
    trExplanation: 'Tanıtım afişleri, kenar çubuğu reklamları veya sürüm yükseltme pencereleri yer almaz. Arayüzün tamamı belge okumaya ve sayfa araçlarına ayrılır.',
    codeSource: 'crates/barepdf-ui',
  },
  {
    number: '04',
    refusal: 'Offline by Default Execution',
    trRefusal: 'Varsayılan Olarak Çevrimdışı Çalışma',
    explanation: 'Parsing, rendering, annotations, and page tools execute locally on CPU. Network calls remain disabled until you explicitly opt in to update checks, which verify Ed25519 signatures and SHA-256 hashes.',
    trExplanation: 'Ayrıştırma, işleme, not alma ve sayfa araçları yalnızca yerel CPU üzerinde çalışır. Güncelleme denetimleri varsayılan olarak kapalıdır; yalnızca siz etkinleştirdiğinizde Ed25519 imzası ve SHA-256 özetiyle doğrulanır.',
    codeSource: 'apps/barepdf/src/infrastructure/update',
  },
];
---

<section class="philosophy-section" aria-labelledby="philosophy-heading">
  <div class="container">
    <div class="philosophy-box">
      <div class="philosophy-header">
        <span class="badge badge-accent">
          <span data-i18n data-en="Engineering Stance" data-tr="Mühendislik Duruşu">Engineering Stance</span>
        </span>
        <h2 id="philosophy-heading" class="philosophy-title" data-i18n data-en="What BarePDF Deliberately Omits" data-tr="BarePDF'in Bilinçli Olarak Dışarıda Bıraktıkları">
          What BarePDF Deliberately Omits
        </h2>
        <p class="philosophy-subtitle" data-i18n
          data-en="Desktop document software routinely bundles cloud accounts, telemetry collectors, and background services. BarePDF enforces four architectural exclusions directly in code."
          data-tr="Masaüstü belge yazılımları genellikle bulut hesapları, telemetri toplayıcıları ve arka plan servisleri taşır. BarePDF dört mimari sınırı doğrudan kod düzeyinde uygular.">
          Desktop document software routinely bundles cloud accounts, telemetry collectors, and background services. BarePDF enforces four architectural exclusions directly in code.
        </p>
      </div>

      <div class="refusals-grid">
        {refusals.map((item) => (
          <div class="refusal-item">
            <div class="refusal-top">
              <span class="refusal-num">{item.number}</span>
              <span class="refusal-source"><code>{item.codeSource}</code></span>
            </div>
            <h3 class="refusal-title" data-i18n data-en={item.refusal} data-tr={item.trRefusal}>{item.refusal}</h3>
            <p class="refusal-desc" data-i18n data-en={item.explanation} data-tr={item.trExplanation}>{item.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    padding: 2.5rem 0 4rem;
  }

  .philosophy-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .philosophy-header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .philosophy-title {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .philosophy-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .refusals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .refusal-item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .refusal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .refusal-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .refusal-source code {
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .refusal-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .refusal-desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .philosophy-box {
      padding: 1.5rem;
    }
    .refusals-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
