---
import { formatBytes } from '../lib/releases';
import type { ReleaseAsset } from '../lib/releases';

interface Props {
  asset: ReleaseAsset;
  title: string;
  description: string;
  badge?: string;
  iconType: 'installer' | 'portable' | 'checksum' | 'deb' | 'appimage';
}

const { asset, title, description, badge, iconType } = Astro.props;
const localizedTitle = {
  'Windows Setup Installer': 'Windows kurulum paketi',
  'Portable ZIP Package': 'Taşınabilir ZIP paketi',
  'SHA-256 Checksums': 'SHA-256 sağlama değerleri',
  'Debian / Pardus Package': 'Debian / Pardus paketi',
  'AppImage Package': 'AppImage paketi',
}[title] ?? title;
const localizedDescription = {
  'Recommended for desktop installation. Registers BarePDF in Windows Open With and Default Apps settings without admin rights.': 'Masaüstü kurulumu için önerilir. BarePDF’i yönetici izni olmadan Windows Birlikte Aç ve Varsayılan Uygulamalar’a kaydeder.',
  'Zero-install archive. Extract anywhere and run BarePDF.exe directly without registry modifications or installation.': 'Kurulum gerektirmeyen arşiv. Her yere çıkarıp kayıt defterini değiştirmeden BarePDF.exe’yi çalıştırın.',
  'Official SHA256SUMS.txt manifest file to verify cryptographic integrity of release binaries.': 'Sürüm dosyalarının kriptografik bütünlüğünü doğrulamak için resmi SHA256SUMS.txt bildirimi.',
  'Standard package for Pardus 23/25, Debian, and Ubuntu. Install via Pardus Paket Kurucu or sudo apt install.': 'Pardus 23/25, Debian ve Ubuntu için standart paket. Pardus Paket Kurucu veya sudo apt install ile kurun.',
  'Universal standalone portable Linux package. Make executable (chmod +x) and run anywhere.': 'Evrensel taşınabilir Linux paketi. Çalıştırılabilir yapın (chmod +x) ve her yerde çalıştırın.',
}[description] ?? description;
---

<div class="download-card">
  <div class="card-header">
    <div class="card-icon">
      {iconType === 'installer' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
      {iconType === 'portable' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="21 8 21 21 3 21 3 8"></polyline>
          <rect x="1" y="3" width="22" height="5"></rect>
          <line x1="10" y1="12" x2="14" y2="12"></line>
        </svg>
      )}
      {iconType === 'checksum' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      )}
      {iconType === 'deb' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      )}
      {iconType === 'appimage' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      )}
    </div>
    
    <div>
      <div class="title-row">
        <h3 class="card-title" data-i18n data-en={title} data-tr={localizedTitle}>{title}</h3>
        {badge && <span class="badge" data-i18n data-en={badge} data-tr={badge === 'Recommended' ? 'Önerilen' : badge === 'Portable' ? 'Taşınabilir' : 'Doğrulama'}>{badge}</span>}
      </div>
      <p class="card-desc" data-i18n data-en={description} data-tr={localizedDescription}>{description}</p>
    </div>
  </div>

  <div class="card-footer">
    <div class="asset-meta">
      <span class="filename">{asset.name}</span>
      <span class="filesize">{formatBytes(asset.size)}</span>
    </div>

    <a href={asset.downloadUrl} rel="noopener noreferrer" class="btn btn-primary btn-download">
      <span data-i18n data-en="Download" data-tr="İndir">Download</span>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .download-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .download-card:hover {
    border-color: var(--color-accent-border);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    gap: 1rem;
  }

  .card-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    gap: 1rem;
  }

  .asset-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .filename {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .filesize {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .btn-download {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
</style>
