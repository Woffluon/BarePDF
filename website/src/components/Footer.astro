---
import { repository } from '../lib/repository';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-col brand-col">
      <div class="brand-heading">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 256 256"
          width="24"
          height="24"
          class="brand-logo"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M80 20 H224 V188 L176 236 H32 V68 Z M96 52 H192 V168 L164 196 V80 H68 Z M64 112 H132 V204 H64 Z"
          />
        </svg>
        <span class="brand-title">BarePDF</span>
      </div>
      <p class="brand-desc">
        <span
          data-i18n
          data-en="Offline, memory-bounded PDF reader and editor for Windows 10/11 and Linux built with Rust, Slint, and PDFium."
          data-tr="Windows 10/11 ve Linux için Rust, Slint ve PDFium ile geliştirilen çevrimdışı, bellek sınırlı PDF okuyucu ve düzenleyici."
        >
          Offline, memory-bounded PDF reader and editor for Windows 10/11 and Linux built with Rust, Slint, and PDFium.
        </span>
      </p>
      <p
        class="privacy-note"
        data-i18n
        data-en="0 Telemetry • 0 Analytics • 0 Accounts • Offline by Default"
        data-tr="0 Telemetri • 0 Analitik • 0 Hesap • Varsayılan Çevrimdışı"
      >
        0 Telemetry • 0 Analytics • 0 Accounts • Offline by Default
      </p>
    </div>

    <div class="footer-col">
      <h4 class="col-title" data-i18n data-en="Documentation" data-tr="Belgeler">Documentation</h4>
      <ul class="footer-links">
        <li><a href={`${baseUrl}/docs/user/getting-started`} data-i18n data-en="User Guide" data-tr="Kullanıcı rehberi">User Guide</a></li>
        <li><a href={`${baseUrl}/docs/user/installation`} data-i18n data-en="Installation" data-tr="Kurulum">Installation</a></li>
        <li><a href={`${baseUrl}/docs/user/keyboard-shortcuts`} data-i18n data-en="Keyboard Shortcuts" data-tr="Klavye kısayolları">Keyboard Shortcuts</a></li>
        <li><a href={`${baseUrl}/docs/user/troubleshooting`} data-i18n data-en="Troubleshooting" data-tr="Sorun giderme">Troubleshooting</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="col-title" data-i18n data-en="Developers" data-tr="Geliştiriciler">Developers</h4>
      <ul class="footer-links">
        <li><a href={`${baseUrl}/docs/developer/getting-started`} data-i18n data-en="Developer Overview" data-tr="Geliştirici özeti">Developer Overview</a></li>
        <li><a href={`${baseUrl}/docs/developer/building`} data-i18n data-en="Build from Source" data-tr="Kaynaktan derleme">Build from Source</a></li>
        <li><a href={`${baseUrl}/docs/developer/architecture`} data-i18n data-en="Architecture" data-tr="Mimari">Architecture</a></li>
        <li><a href={`${baseUrl}/docs/developer/contributing`} data-i18n data-en="Contributing" data-tr="Katkıda bulunma">Contributing</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="col-title" data-i18n data-en="Project" data-tr="Proje">Project</h4>
      <ul class="footer-links">
        <li><a href={`${baseUrl}/download`} data-i18n data-en="Download Release" data-tr="Sürümü indir">Download Release</a></li>
        <li><a href={`${baseUrl}/changelog`} data-i18n data-en="Changelog" data-tr="Değişiklik günlüğü">Changelog</a></li>
        <li><a href={repository.url} target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
        <li><a href={`${repository.url}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} BarePDF Contributors. <span data-i18n data-en="Released under the MIT License." data-tr="MIT Lisansı ile yayımlanır.">Released under the MIT License.</span></p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .brand-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .brand-logo {
    display: block;
    flex-shrink: 0;
  }

  .brand-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .privacy-note {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .col-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
  }
</style>
