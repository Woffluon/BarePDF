---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="screenshot-section">
  <div class="container">
    <div class="screenshot-frame">
      <picture class="screenshot-picture">
        <img
          src={`${baseUrl}/images/app-interface.png`}
          alt="BarePDF desktop PDF reader showing the document canvas, thumbnail sidebar, and orange toolbar controls"
          width="1260"
          height="926"
          loading="eager"
          decoding="async"
          class="screenshot-img"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .screenshot-section {
    padding: 1rem 0 4rem;
  }

  .screenshot-frame {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-normal);
  }

  .screenshot-frame:hover {
    transform: translateY(-2px);
  }

  .screenshot-picture {
    display: block;
    width: 100%;
  }

  .screenshot-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
